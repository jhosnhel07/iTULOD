# Copy to secrets.env and fill in values. Never commit secrets.env.
# Used for Supabase Edge Functions (local dev) and server-side PayMongo calls.

# Local-only: the hosted platform injects these automatically. Don't set them
# as remote secrets.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# App secrets — set these on the remote project by name:
#   supabase secrets set PAYMONGO_SECRET_KEY=... PAYMONGO_WEBHOOK_SECRET=... SITE_URL=...
PAYMONGO_SECRET_KEY=sk_test_...
PAYMONGO_WEBHOOK_SECRET=whsk_...
# Absolute origin, no trailing slash — used to build the GCash return URL.
SITE_URL=http://localhost:3000
